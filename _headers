/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/data.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/incidents.csv
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
  Content-Type: text/csv; charset=utf-8

/archive.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/archive.csv
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
  Content-Type: text/csv; charset=utf-8
