{
  // Static site served by Cloudflare Workers (static assets only, no code)
  "name": "violationswatch",
  "compatibility_date": "2026-11-01",
  // Only serve the site on violationswatch.org, not on workers.dev or preview addresses
  "workers_dev": false,
  "preview_urls": false,
  // before each deploy: builds blog/posts.json, then the incident share pages and preview images.
  // If the previews fail, the site still deploys without them.
  "build": { "command": "node scripts/build-blog.js && (npm ci --no-audit --no-fund && node scripts/build-previews.mjs || echo 'Preview build failed; deploying without previews')" },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
