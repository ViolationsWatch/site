{
  // Static site served by Cloudflare Workers (static assets only, no code)
  "name": "violationswatch",
  "compatibility_date": "2026-11-01",
  // Only serve the site on violationswatch.org, not on workers.dev or preview addresses
  "workers_dev": false,
  "preview_urls": false,
  // builds blog/posts.json from the Markdown posts before each deploy
  "build": { "command": "node scripts/build-blog.js" },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
